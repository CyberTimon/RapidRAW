{
  "name": "@sheldonxxxx/rapidraw-mcp",
  "version": "0.2.0",
  "description": "Local MCP interface to RapidRAW's native nondestructive photo engine",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sheldonxxxx/RapidRAW.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/sheldonxxxx/RapidRAW/tree/main/mcp",
  "bugs": {
    "url": "https://github.com/sheldonxxxx/RapidRAW/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rapidraw",
    "photo-editing",
    "raw",
    "photography"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "rapidraw-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build && npm test",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:engine": "npm run build && node scripts/engine-e2e.mjs",
    "test:assets": "npm run build && node scripts/asset-e2e.mjs",
    "test:review-jobs": "npm run build && node scripts/review-jobs-e2e.mjs",
    "test:coverage": "npm run build && node scripts/coverage-e2e.mjs",
    "test:delivery": "npm run build && node scripts/export-interoperability-e2e.mjs",
    "test:operation-jobs": "npm run build && node scripts/operation-jobs-e2e.mjs",
    "test:models-provider": "npm run build && node scripts/model-provider-e2e.mjs",
    "test:photo-quality": "npm run build && node scripts/photo-quality-e2e.mjs",
    "test:setup": "npm run build && node scripts/fresh-setup.mjs",
    "test:geometry": "npm run build && node scripts/geometry-review-e2e.mjs",
    "test:mask-composition": "npm run build && node scripts/mask-composition-e2e.mjs",
    "test:portable": "npm run build && node scripts/portable-sessions-e2e.mjs",
    "coverage": "node scripts/coverage-report.mjs",
    "test:large": "npm run build && node scripts/large-image-e2e.mjs",
    "test:advanced": "npm run build && node scripts/advanced-e2e.mjs",
    "test:denoise": "npm run build && node scripts/denoise-e2e.mjs",
    "test:surfaces": "npm run build && node scripts/marigold-surfaces-e2e.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  }
}
